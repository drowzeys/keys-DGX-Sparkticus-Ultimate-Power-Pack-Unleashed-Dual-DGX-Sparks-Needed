# Power Pack dual-boot profile — nodes .1 + .5
# Based on tonyd2wild/ds4-h3-video-gen-factory
export HEAD=10.100.10.1
export WORKER=10.100.10.5
export HEAD_SSH=keyspark@10.100.10.1
export WORKER_SSH=keyspark@10.100.10.5
export H3_HEAD=${H3_HEAD:-${HEAD}:8188}
export H3_WORKER=${H3_WORKER:-${WORKER}:8188}
export H3_FLEET_CONCURRENCY=2
export H3_QUALITY_ID=1
export H3_SPECTRUM=1
export H3_UPSCALE=RealESRGAN_x2plus.pth
export STACK=ablit
export ENV_SRC="${ENV_SRC:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env.ablit-cotenancy-888k-u076-nodes-1-5}"
